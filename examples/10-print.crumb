on_loop = {
  // print random slash
  (print (if (integer (add (random) 0.5)) {<- "╱"} {<- "╲"}))

  <- state
} 

on_keypress = {
  (print " key pressed:" keypress_name " ")
  <- state
}

on_down = {
  (print " mouse down ")
  <- state
}

on_up = {
  (print " mouse up ")
  <- state
}

on_move = {
  (print " mouse move" (string (get mouse_xy 0)) (string (get mouse_xy 1)) " ")
  <- state
}

on_drag = {
  (print " mouse drag" (string (get mouse_xy 0)) (string (get mouse_xy 1)) " ")
  <- state
}

on_scroll = {
  (print " scroll "  scroll_direction " " )
  <- state
}


listeners = (list 
  (list void on_loop on_keypress on_down on_up on_move on_drag on_scroll)
)

// state needs to be anything other than void for loop to run
state = 0

// event loop
(use "./event-loop.crumb" {
  <- (start state listeners 0.1)
})
