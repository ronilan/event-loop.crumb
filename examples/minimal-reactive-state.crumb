on_move = { 
  <- (add state 1)
}

on_state = {
  (print (reduce (map (range state) {_ _ -> <- "="}) {accum item _ -> <- (join accum item)} "") "\n")
  <- state
}

listeners = (list 
  (list on_state void void void void on_move void void)
)

state = 1

// event loop
(use "./event-loop.crumb" {
  <- (start state listeners void)
})
